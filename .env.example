# PostgreSQL & Supabase Infrastructure
DATABASE_URL="postgresql://postgres:password@localhost:5432/vidyapulse"
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Pan-India Speech Recognition (ASR) APIs
SARVAM_API_KEY="your-sarvam-ai-api-key"
BHASHINI_API_KEY="your-bhashini-api-key"
BHASHINI_USER_ID="your-bhashini-user-id"

# LLM Providers & Vision Models
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
# Generation model for chat, cheat sheets, study sets and slide OCR
GEMINI_CHAT_MODEL="gemini-3.8-flash"
# Seconds before a Gemini call gives up; Gemini also uses it as its own deadline (504 when exceeded)
GEMINI_TIMEOUT_SECONDS="120"
# minimal, low, medium or high; empty uses the model default. Lower answers faster.
GEMINI_THINKING_LEVEL="low"

# Task 19 cache for query embeddings, searches and answers. Empty uses an in-process cache.
# Set it to share the cache across uvicorn workers and keep it across restarts ($0 options:
# `brew install redis && brew services start redis`, or a free Upstash database's rediss:// URL).
REDIS_URL=""
# How long each kind of entry is kept, in seconds. 0 turns answer caching off.
CACHE_EMBEDDING_TTL_SECONDS="2592000"
CACHE_SEARCH_TTL_SECONDS="21600"
CACHE_ANSWER_TTL_SECONDS="86400"

# Environment Settings
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:8000"
