# PostgreSQL & Supabase Infrastructure
DATABASE_URL="postgresql://postgres:password@localhost:5432/vidyapulse"
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Pan-India Speech Recognition (ASR) APIs
SARVAM_API_KEY="your-sarvam-ai-api-key"
BHASHINI_API_KEY="your-bhashini-api-key"
BHASHINI_USER_ID="your-bhashini-user-id"

# LLM Providers & Vision Models
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
# Generation model for chat, cheat sheets, study sets and slide OCR
GEMINI_CHAT_MODEL="gemini-1.5-flash"

# Environment Settings
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:8000"
