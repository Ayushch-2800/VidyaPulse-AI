# PostgreSQL & Supabase Infrastructure
DATABASE_URL="postgresql://postgres:password@localhost:5432/vidyapulse"
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Pan-India Speech Recognition (ASR) APIs
SARVAM_API_KEY="your-sarvam-ai-api-key"
BHASHINI_API_KEY="your-bhashini-api-key"
BHASHINI_USER_ID="your-bhashini-user-id"

# LLM Providers & Vision Models
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
# Generation model for chat, cheat sheets, study sets and slide OCR
GEMINI_CHAT_MODEL="gemini-3.8-flash"
# Seconds before a Gemini call gives up; Gemini also uses it as its own deadline (504 when exceeded)
GEMINI_TIMEOUT_SECONDS="120"
# minimal, low, medium or high; empty uses the model default. Lower answers faster.
GEMINI_THINKING_LEVEL="low"

# Environment Settings
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:8000"
# Web origins the API accepts, comma-separated. Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS="http://localhost:3000"
# Optional extra origin pattern, e.g. Vercel preview URLs
CORS_ORIGIN_REGEX=""
# The web app's public URL, for SEO metadata, the sitemap and robots.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
