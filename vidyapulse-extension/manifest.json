{
    "manifest_version": 3,
    "name": "VidyaPulse Audio Ingestion",
    "version": "1.0",
    "permissions": [
      "offscreen",
      "tabCapture",
      "storage",       
      "activeTab"
    ],
    "host_permissions": [
      "http://localhost:8000/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    }
  }